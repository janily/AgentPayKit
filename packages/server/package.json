{
  "name": "@agentpaykit/server",
  "version": "0.1.0-alpha.2",
  "description": "Thin Next.js server adapter for Base Sepolia synchronous x402 paid Skills",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janily/AgentPayKit.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/janily/AgentPayKit#readme",
  "bugs": {
    "url": "https://github.com/janily/AgentPayKit/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "agentpay",
    "agentpaykit",
    "x402",
    "base-sepolia",
    "usdc",
    "nextjs"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./next": "./dist/next.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "@x402/next": "2.19.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vitest": "2.1.9"
  },
  "peerDependencies": {
    "next": "16.2.10"
  }
}
